DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DWP_TENANT_ID=dachwerk

# Stable authenticated user ID of Stephan; exports fail closed if unset.
DWP_OWNER_USER_ID=

# DWP → Make → Dropbox (optional). Ohne Webhook-Adresse ist die Ablage abgeschaltet.
# Signierschlüssel: eigenes DWP_MAKE_SECRET (mind. 32 Zeichen) oder automatisch aus BETTER_AUTH_SECRET abgeleitet.
DWP_MAKE_WEBHOOK_URL=
DWP_MAKE_SECRET=
# Wurzelordner in Dropbox (Standard: DWP)
DWP_DROPBOX_ROOT=
