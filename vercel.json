{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(), display-capture=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; frame-src 'self' blob:"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth?authPath=:path*"
    },
    {
      "source": "/workspace",
      "destination": "/api/workspace"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "public"
}
